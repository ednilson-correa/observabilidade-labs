# Copie para .env e ajuste se alguma porta já estiver em uso na sua máquina.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
OTEL_HTTP_PORT=4318

# Amostragem de cabeça aplicada no Collector (%). Teste 25, 10, 5...
SAMPLING_PERCENTAGE=25

# Carga gerada pelo loadgen
TRACES_POR_SEGUNDO=20
PERCENTUAL_ERRO=5

# Credenciais do Grafana SOMENTE para o lab local. Troque antes de expor.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-me
