          "refId": "A",
          "expr": "1 - rate(otelcol_process_cpu_seconds{instancia=\"protobuf-0.163.1\"}[5m]) / ignoring(instancia, instance) rate(otelcol_process_cpu_seconds{instancia=\"json-0.163.1\"}[5m])",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
