    {
      "id": 8,
      "type": "table",
      "title": "O mesmo SQL, três telemetrias diferentes",
      "description": "Cada linha é uma combinação de nome de span + atributos de banco vista pelo span_metrics. '-' = atributo ausente. Compare o nome do span (SELECT pedidos.pedidos x SELECT pedidos) e quais chaves existem em cada modo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, span_name, db_system, db_name, db_operation, db_system_name, db_namespace, db_query_summary) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", span_name!~\"CREATE.*\"}[5m]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service_name": 0,
              "span_name": 1,
              "db_system": 2,
              "db_name": 3,
              "db_operation": 4,
              "db_system_name": 5,
              "db_namespace": 6,
              "db_query_summary": 7,
              "Value": 8
            },
            "renameByName": {
              "service_name": "Serviço",
              "span_name": "Nome do span",
              "db_system": "db.system (legado)",
              "db_name": "db.name (legado)",
              "db_operation": "db.operation (legado)",
              "db_system_name": "db.system.name (novo)",
              "db_namespace": "db.namespace (novo)",
              "db_query_summary": "db.query.summary (novo)",
              "Value": "spans/s"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Serviço"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Serviço"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pedidos-legado": {
                        "color": "#f0643c",
                        "index": 0
                      },
                      "pedidos-dup": {
                        "color": "#b58cff",
                        "index": 1
                      },
                      "pedidos-v3": {
                        "color": "#6e8cff",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(legado\\)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f0643c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(novo\\)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6e8cff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spans/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
