      "title": "Só convenção legada",
      "description": "Serviços cujos spans de banco têm db.system e NÃO têm db.system.name (Java agent 2.x padrão). São os que vão mudar no 3.0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_CLIENT\", db_system!=\"-\", db_system_name=\"-\"}[5m])) > 0) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
