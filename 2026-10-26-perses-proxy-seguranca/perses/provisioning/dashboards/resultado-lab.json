                    "query": "sum(rate(lab_perses_proxy_request_duration_seconds_sum{instancia=\"perses-054\",datasource=\"prom-local\"}[1m])) / sum(rate(lab_perses_proxy_request_duration_seconds_count{instancia=\"perses-054\",datasource=\"prom-local\"}[1m]))",
                    "seriesNameFormat": "0.54"
                  }
                }
              }
            },
