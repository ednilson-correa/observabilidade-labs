          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec",
                  "decimalPlaces": 2
                }
              },
              "visual": {
                "display": "line",
                "lineWidth": 2,
                "areaOpacity": 0.45,
                "connectNulls": false,
                "stack": "all"
              },
              "querySettings": [
                {
                  "queryIndex": 0,
                  "colorMode": "fixed",
                  "colorValue": "#6e8cff"
