      "tslocal": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Proxy → http://localhost:9090 (req/s por resultado)",
            "description": "Taxa de respostas por instância e código HTTP para o datasource no mesmo host (séries empilhadas)."
