{
  "kind": "Dashboard",
  "metadata": {
    "name": "resultado-lab",
    "project": "lab"
  },
  "spec": {
    "display": {
      "name": "Perses 0.54 x 0.55 · proxy de datasources",
      "description": "Lab 2026-10-26: o hardening do proxy (SSRF) do Perses 0.55 na prática."
    },
    "duration": "15m",
    "refreshInterval": "10s",
    "panels": {
      "s054local": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "0.54 · localhost OK",
            "description": "Percentual de respostas HTTP 200 do proxy do Perses 0.54 para o datasource http://localhost:9090 (último minuto)."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percent",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#6e8cff",
                "steps": []
              },
              "colorMode": "value",
              "sparkline": {
                "color": "#6e8cff",
                "width": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-rede"
                    },
                    "query": "100 * sum(rate(lab_perses_proxy_requests_total{instancia=\"perses-054\",datasource=\"prom-local\",code=\"200\"}[1m])) / sum(rate(lab_perses_proxy_requests_total{instancia=\"perses-054\",datasource=\"prom-local\"}[1m])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "s055local": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "0.55 · localhost 403",
            "description": "Percentual de respostas HTTP 403 (destino não permitido) do Perses 0.55 com a config padrão para o MESMO datasource salvo antes do upgrade."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percent",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#f0643c",
                "steps": []
              },
              "colorMode": "value",
              "sparkline": {
                "color": "#f0643c",
                "width": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-rede"
                    },
                    "query": "100 * sum(rate(lab_perses_proxy_requests_total{instancia=\"perses-055\",datasource=\"prom-local\",code=\"403\"}[1m])) / sum(rate(lab_perses_proxy_requests_total{instancia=\"perses-055\",datasource=\"prom-local\"}[1m])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "s055lib": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "0.55 liberado · OK",
            "description": "Perses 0.55 com datasource.proxy.allowed_networks = 127.0.0.0/8 e ::1/128."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percent",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#3ccf91",
                "steps": []
              },
              "colorMode": "value",
              "sparkline": {
                "color": "#3ccf91",
                "width": 1
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-rede"
                    },
                    "query": "100 * sum(rate(lab_perses_proxy_requests_total{instancia=\"perses-055-liberado\",datasource=\"prom-local\",code=\"200\"}[1m])) / sum(rate(lab_perses_proxy_requests_total{instancia=\"perses-055-liberado\",datasource=\"prom-local\"}[1m])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "srede": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rede privada · OK",
            "description": "Percentual de HTTP 200 para http://prometheus:9090 (rede privada do Docker) somando as três instâncias. Rede privada continua liberada por padrão."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percent",
                "decimalPlaces": 0
              },
              "thresholds": {
                "defaultColor": "#8a94b0",
                "steps": []
