          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-rede"
                    },
                    "query": "max(lab_perses_proxy_csp_sandbox{instancia=\"perses-055\"})"
                  }
                }
              }
            }
          ]
        }
