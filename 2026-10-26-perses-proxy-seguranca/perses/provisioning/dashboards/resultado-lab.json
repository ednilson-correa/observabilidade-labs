      "tslat": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Latência média do proxy · localhost",
            "description": "rate(_sum)/rate(_count) do gerador de tráfego. O 403 é decidido antes de abrir conexão."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "list"
              },
              "yAxis": {
                "format": {
                  "unit": "seconds",
                  "decimalPlaces": 1
                }
              },
              "visual": {
                "display": "line",
                "lineWidth": 2,
                "areaOpacity": 0.15,
                "connectNulls": false
              },
              "querySettings": [
                {
                  "queryIndex": 0,
                  "colorMode": "fixed",
                  "colorValue": "#6e8cff"
                },
                {
                  "queryIndex": 1,
                  "colorMode": "fixed",
                  "colorValue": "#f0643c"
                },
