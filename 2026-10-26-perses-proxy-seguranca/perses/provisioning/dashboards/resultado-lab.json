            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-rede"
                    },
                    "query": "100 * sum(rate(lab_perses_proxy_requests_total{datasource=\"prom-rede\",code=\"200\"}[1m])) / sum(rate(lab_perses_proxy_requests_total{datasource=\"prom-rede\"}[1m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "csp054": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CSP sandbox · 0.54",
            "description": "As respostas do proxy trazem Content-Security-Policy: sandbox? (última resposta 200)"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0,
                "shortValues": false
              },
              "thresholds": {
                "defaultColor": "#6e8cff",
                "steps": []
              },
              "colorMode": "value",
              "mappings": [
                {
                  "kind": "Value",
                  "spec": {
                    "value": "0",
                    "result": {
                      "value": "ausente",
                      "color": "#6e8cff"
                    }
                  }
                },
                {
                  "kind": "Value",
                  "spec": {
                    "value": "1",
                    "result": {
                      "value": "presente",
                      "color": "#6e8cff"
                    }
                  }
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource",
                      "name": "prom-rede"
                    },
                    "query": "max(lab_perses_proxy_csp_sandbox{instancia=\"perses-054\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "csp055": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CSP sandbox · 0.55",
            "description": "Mesma verificação no Perses 0.55 (padrão)."
